---
import Navbar from "../../components/prod/Navbar";
import DispositionModule from "../../components/cmm/DispositionModule";
import Layout from "../../layouts/Layout.astro";

if (!Astro.cookies.has("auth")) {
  return Astro.redirect("/");
} else {
  const cookie = Astro.cookies.get("auth");
  const value = cookie?.number();

  if (value != 2) {
    return Astro.redirect("/");
  }
}
---

<Layout title="CMM Dashboard">
  <Navbar client:load />
  <DispositionModule client:load />
</Layout>
