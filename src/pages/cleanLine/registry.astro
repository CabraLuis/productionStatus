---
import { prisma } from "../../lib/prisma";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/cleanLine/Navbar";
import "simple-datatables/dist/style.css";
function formatDateTime(date: Date | string | null) {
  if (!date) return "";

  return new Intl.DateTimeFormat("es-MX", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: false,
  }).format(new Date(date));
}

function formatWorkOrder(workOrder: string) {
  return workOrder.split("@")[0];
}

function formatMinutes(value: number | null | undefined) {
  if (value == null) return "";
  return `${value} min.`;
}

const registry = await prisma.workOrderStatusRegistry.findMany({
  include: {
    workOrder: {
      include: {
        deliveredBy: true,
        deliveredTo: true,
        operator: {
          include: {
            beeper: true,
          },
        },
        part: true,
        status: true,
        technician: true,
        step: true,
      },
    },
    status: true,
  },
  where: {
    workOrder: {
      deliveredToId: 2,
    },
  },
  orderBy: [{ workOrderId: "asc" }, { statusId: "asc" }],
});

const rows = registry.map((log) => {
  const wo = log.workOrder;

  return {
    id: log.id,
    partNumber: wo.part.number,
    workOrder: formatWorkOrder(wo.workOrder),
    quantity: `${wo.quantity} pz.`,
    step: wo.step.step,
    technician: wo.technician?.name ?? "",
    estimatedTime: formatMinutes(wo.estimatedTime),
    department: wo.deliveredBy.name,
    beeper: wo.operator?.beeper?.number ?? "",
    startedAt: formatDateTime(log.startedAt),
    elapsedTime: formatMinutes(log.elapsedTime),
    priority: wo.priority,
    status: log.status.status,
    delayed:
      log.statusId === 2 && wo.timeDelayed != null && wo.timeDelayed > 0
        ? formatMinutes(wo.timeDelayed)
        : "",
  };
});
---

<script>
  import { DataTable, exportCSV } from "simple-datatables";

  let dataTable: any;

  function initTable() {
    const table: HTMLTableElement = document.querySelector("#data")!;
    const exportButton = document.querySelector("#export");

    if (!table || !exportButton) return;

    if (dataTable) {
      dataTable.destroy();
    }

    dataTable = new DataTable(table, {
      searchable: true,
      perPage: 9,
      perPageSelect: [9, 15, 25, 50, 100],
      sortable: true,

      labels: {
        placeholder: "Buscar 🔎",
        noRows: "No se encontró información",
        info: "Mostrando {start} a {end} de {rows} logs",
        perPage: "logs por página",
        noResults: "No se encontró información",
      },

      classes: {
        top: "flex items-center justify-between gap-4 mb-4",
        bottom: "grid grid-cols-1 justify-items-center gap-2 mt-4",
        search: "ml-4",
        input: "input input-bordered input-sm",
        dropdown: "ml-4",
        selector: "select select-bordered select-sm",
        paginationList: "join",
        paginationListItem: "join-item",
        paginationListItemLink: "btn btn-ghost btn-sm",
        active: "btn-active",
      },
    });

    exportButton.addEventListener("click", () => {
      exportCSV(dataTable, {
        download: true,
        lineDelimiter: "\r\n",
        filename: "clean-line-log",
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTable);
  } else {
    initTable();
  }

  document.addEventListener("astro:page-load", initTable);
</script>

<Layout title="Clean Line Registry">
  <Navbar client:load />

  <main class="min-h-screen grow bg-base-200 p-4">
    <section class="rounded-xl bg-base-100 p-4 shadow-md">
      <div class="mb-4 flex items-center justify-between gap-4">
        <div>
          <h1 class="text-3xl font-black text-black">Clean Line Registry</h1>

          <p class="text-sm font-bold text-black/60">
            Haz click en los títulos para ordenar la información.
          </p>
        </div>

        <button class="btn btn-primary btn-sm font-black" id="export">
          Descargar CSV
        </button>
      </div>

      <div class="w-full overflow-x-auto">
        <table class="table table-zebra table-pin-rows bg-base-100" id="data">
          <thead>
            <tr>
              <th>Log ID</th>
              <th>No. Parte</th>
              <th>No. WO</th>
              <th>Cantidad</th>
              <th>Step</th>
              <th>Técnico</th>
              <th>Tiempo Est.</th>
              <th>Departamento</th>
              <th>Beeper</th>
              <th>Inicio</th>
              <th>Duración Real</th>
              <th>Prioridad</th>
              <th>Estado</th>
              <th>Retardo</th>
            </tr>
          </thead>

          <tbody>
            {
              rows.map((row) => (
                <tr id={`log-${row.id}`}>
                  <td>{row.id}</td>
                  <td>{row.partNumber}</td>
                  <td>{row.workOrder}</td>
                  <td>{row.quantity}</td>
                  <td>{row.step}</td>
                  <td>{row.technician}</td>
                  <td>{row.estimatedTime}</td>
                  <td>{row.department}</td>
                  <td>{row.beeper}</td>
                  <td>{row.startedAt}</td>
                  <td>{row.elapsedTime}</td>
                  <td>{row.priority}</td>
                  <td>{row.status}</td>
                  <td class={row.delayed ? "font-black text-error" : ""}>
                    {row.delayed}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>
  </main>
</Layout>
